Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\jtstudio]
@="URL:JT Studio Protocol"
"URL Protocol"=""

[HKEY_CLASSES_ROOT\jtstudio\shell]

[HKEY_CLASSES_ROOT\jtstudio\shell\open]

[HKEY_CLASSES_ROOT\jtstudio\shell\open\command]
@="powershell.exe -WindowStyle Hidden -Command \"Invoke-RestMethod -Uri 'http://127.0.0' -Method Post\""
